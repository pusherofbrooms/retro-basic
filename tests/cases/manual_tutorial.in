PRINT "HELLO, PROGRAMMER!"
PRINT 2+3*4
NEW
10 FOR I=1 TO 5
20 PRINT I;
30 NEXT I
40 PRINT ""
RUN
NEW
10 SCORE=7
20 IF SCORE>=5 THEN PRINT "LEVEL UP"
RUN
NEW
10 PRINT "START"
20 GOSUB 100
30 PRINT "END"
40 END
100 PRINT "IN SUBROUTINE"
110 RETURN
RUN
NEW
10 DATA 3,4,5
20 READ A,B,C
30 PRINT A+B+C
40 RESTORE
50 READ A
60 PRINT A
RUN
NEW
10 DIM N(3)
20 N(1)=10
30 N(2)=20
40 N(3)=N(1)+N(2)
50 PRINT N(3)
RUN
NEW
10 DEF FNSQ(X)=X*X
20 PRINT FNSQ(6)
RUN
PRINT LEFT$("COMMODORE",4)
PRINT MID$("COMMODORE",5,3)
PRINT RIGHT$("COMMODORE",4)
PRINT CHR$(65)
PRINT ASC("Z")
RANDOMIZE 42
PRINT RND(1)
PRINT RND(0)
SAVE "build/manual-save.bas"
NEW
LOAD "build/manual-save.bas"
LIST
RUN
INPUT NAME$
Ada
PRINT "HI ";NAME$
