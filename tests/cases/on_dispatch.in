10 ON 2 GOTO 100,200,300
20 PRINT "BAD1"
30 END
100 PRINT "BAD2"
110 END
200 PRINT "GOTO"
210 ON 3 GOSUB 400,500,600
220 PRINT "AFTER"
230 ON 0 GOTO 700,800
240 PRINT "ZERO"
250 ON 9 GOSUB 600
260 PRINT "OOR"
270 END
400 PRINT "BAD3"
410 RETURN
500 PRINT "BAD4"
510 RETURN
600 PRINT "SUB"
610 RETURN
RUN
