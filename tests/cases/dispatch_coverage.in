10 REM DISPATCH COVERAGE
20 LET A=2
30 IF A=2 THEN GOSUB 300 ELSE PRINT "BADIF"
40 FOR I=1 TO 2
50 PRINT I;
60 NEXT I
70 PRINT ""
80 ON 2 GOTO 100,110
90 PRINT "BADON"
95 END
100 PRINT "BADTGT"
105 END
110 DIM N(1),S$(1)
120 DATA 7,"OK"
130 READ N(1),S$(1)
140 RESTORE
150 READ A
160 PRINT A
170 PRINT N(1);S$(1)
180 ON 1 GOSUB 320
190 GOTO 210
200 PRINT "BADGOTO"
210 END
300 PRINT "SUB"
310 RETURN
320 PRINT "OSUB"
330 RETURN
RUN
